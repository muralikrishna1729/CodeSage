GROQ_API_KEY=your_free_groq_key
OPENROUTER_API_KEY=your_free_openrouter_key
GEMINI_API_KEY=your_free_gemini_key
TAVILY_API_KEY=your_free_tavily_key
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=false
EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
COLLECTION_NAME=codebase_chunks
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
API_URL=http://localhost:8010
# REPOS_DIR=/absolute/path/for/cloned/repos  (optional; defaults to ~/.codebase-rag-agent/repos)

# --- LangSmith tracing (optional; needs a free key from smith.langchain.com) ---
# Set LANGSMITH_TRACING=true AND fill LANGCHAIN_API_KEY to upload LangGraph node +
# LLM spans. With tracing off, llm_client short-circuits and nothing leaves the machine.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=CodeSage-Agent